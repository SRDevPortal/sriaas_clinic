{
  "doctype": "DocType",
  "name": "Shipkia Settings",
  "module": "Sriaas Clinic",
  "issingle": 1,
  "autoname": "prompt",
  "engine": "InnoDB",
  "editable_grid": 0,
  "track_changes": 1,
  "field_order": [
    "enable_sync",

    "webhook_url",
    "webhook_header_key",
    "webhook_header_token",

    "shipkia_order_url",
    "shipkia_order_token",

    "pickup_address",
    "order_channel",
    "shipkia_base_url",
    "shipkia_tracking_url"
  ],
  "fields": [
    {
      "fieldname": "enable_sync",
      "fieldtype": "Check",
      "label": "Enable Shipkia Sync",
      "default": "0"
    },

    {
      "fieldname": "webhook_url",
      "fieldtype": "Data",
      "label": "Webhook URL",
      "reqd": 1
    },
    {
      "fieldname": "webhook_header_key",
      "fieldtype": "Data",
      "label": "Webhook Header Key",
      "default": "x-api-key"
    },
    {
      "fieldname": "webhook_header_token",
      "fieldtype": "Password",
      "label": "Webhook Header Token",
      "reqd": 1
    },

    {
      "fieldname": "shipkia_order_url",
      "fieldtype": "Data",
      "label": "Shipkia Order URL",
      "reqd": 1
    },
    {
      "fieldname": "shipkia_order_token",
      "fieldtype": "Password",
      "label": "Shipkia Order Token",
      "reqd": 1
    },

    {
      "fieldname": "pickup_address",
      "fieldtype": "Data",
      "label": "Pickup Address Code",
      "reqd": 1
    },
    {
      "fieldname": "order_channel",
      "fieldtype": "Data",
      "label": "Order Channel",
      "default": "erpsriaas",
      "reqd": 1
    },
    {
      "fieldname": "shipkia_base_url",
      "fieldtype": "Data",
      "label": "Shipkia Base URL"
    },
    {
      "fieldname": "shipkia_tracking_url",
      "fieldtype": "Data",
      "label": "Shipkia Tracking URL",
      "reqd": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    }
  ]
}
